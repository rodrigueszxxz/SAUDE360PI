# ──────────────────────────────────────────────────────────────────
# Saúde 360 — Frontend — Variáveis de Ambiente
# Copie para .env.local e preencha os valores
# NUNCA commite .env.local no Git!
# ──────────────────────────────────────────────────────────────────

# URL do backend — usada pelo proxy do Vite em desenvolvimento.
# Em produção, configure no seu host (Vercel, Netlify, etc.)
# NÃO prefixe com VITE_ — essa variável só é lida pelo servidor Vite,
# não é exposta ao browser.
VITE_BACKEND_URL=http://localhost:3000

# Opcional: URL base da API quando NÃO usar o proxy (ex: deploy separado)
# Se deixar em branco, o frontend usa /api (via proxy Vite)
# VITE_API_BASE_URL=https://api.meusite.com
