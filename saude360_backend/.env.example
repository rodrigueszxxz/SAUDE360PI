# ============================================================
# Saúde 360 — Backend — Variáveis de Ambiente
# Copie este arquivo: cp .env.example .env
# NUNCA commite o .env com credenciais reais!
# ============================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Banco de Dados — Supabase ──────────────────────────────────────────────────
# Acesse: https://supabase.com → Projeto → Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=SUBSTITUA_PELA_SERVICE_ROLE_KEY_DO_SUPABASE

# ── Autenticação JWT ───────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_DE_64_BYTES_AQUI
JWT_REFRESH_SECRET=GERE_OUTRA_CHAVE_ALEATORIA_DE_64_BYTES_AQUI

# ── Webhook de Pagamento ───────────────────────────────────────────────────────
# Segredo HMAC para validar webhooks do gateway de pagamento
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=GERE_UM_SEGREDO_HMAC_AQUI

# ── Twilio — WhatsApp ──────────────────────────────────────────────────────────
# Acesse: https://console.twilio.com
# Para testes: use o Twilio Sandbox para WhatsApp (gratuito)
#   1. Acesse Messaging > Try it out > Send a WhatsApp message
#   2. Envie "join <sandbox-keyword>" para +1 415 523 8886
# Para produção: solicite número aprovado pelo WhatsApp Business API
TWILIO_ACCOUNT_SID=SEU_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=SEU_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Email — SMTP (opcional) ───────────────────────────────────────────────────
# Para Gmail: ative "App Passwords" em myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
EMAIL_FROM="Saúde360 <noreply@saude360.com.br>"

# ── Stripe — Pagamentos ────────────────────────────────────────────────────────
# Acesse: https://dashboard.stripe.com/apikeys
# Use chaves de TESTE (sk_test_...) para desenvolvimento
STRIPE_SECRET_KEY=sk_test_SUBSTITUA_PELA_CHAVE_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_SUBSTITUA_PELO_SEGREDO_WEBHOOK_STRIPE
STRIPE_CURRENCY=brl
STRIPE_VALOR_BASE=60.00

# ── Redis ──────────────────────────────────────────────────────────────────────
# Docker local: redis://redis:6379
# Sem Redis: deixe vazio (sistema usa fallback gracioso)
REDIS_URL=redis://127.0.0.1:6379

# ── LGPD / Auditoria ──────────────────────────────────────────────────────────
# Dias de retenção dos logs de auditoria (mínimo legal: 5 anos = 1825 dias)
AUDIT_LOG_RETENTION_DAYS=1825

# ── Frontend URL (para links em emails/WhatsApp) ───────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GERAL=200
RATE_LIMIT_AUTH=10
RATE_LIMIT_AGENDAMENTO=30

# ── Google Meet (geração de links) ────────────────────────────────────────────
# Não requer configuração adicional — links são gerados via URL pública
# Futuramente: GOOGLE_CALENDAR_CLIENT_ID e GOOGLE_CALENDAR_CLIENT_SECRET
# para criação de eventos automáticos no Google Calendar

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
